# RentalOps — example environment configuration.
# Copy to `.env` (git-ignored) and adjust, or export these in your shell before starting the app.
# Every value below has a safe local-dev default baked into the code; nothing here is required
# to run locally against the docker-compose Postgres.

# ─────────────────────────────── Backend (Spring Boot) ───────────────────────────────
# Database
DB_URL=jdbc:postgresql://localhost:5432/rentalops
DB_USERNAME=rentalops
DB_PASSWORD=rentalops

# HTTP
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth — MUST be overridden with a long random value in any shared/hosted environment
JWT_SECRET=change-me-to-a-64+-character-random-string
JWT_EXPIRATION_MS=86400000
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Background jobs
JOBS_AUTORUN=true
RENT_GENERATE_LEAD_DAYS=7
OUTBOX_POLL_INTERVAL_MS=10000

# Optional: Redis (off by default — app runs on Postgres alone)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
SPRING_CACHE_TYPE=caffeine

# Optional: Claude-powered maintenance triage (falls back to a keyword classifier if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─────────────────────────────── Frontend (Vite) ───────────────────────────────
# Leave empty to use the Vite dev proxy (/api → :8080). Set to an absolute URL for a
# deployed backend, e.g. https://api.example.com
VITE_API_BASE_URL=
